+/*----------------------------------------------------------------------------*/
+static bool joypad_dpad_pressed(struct joypad *joypad, int code)
+{
+	int nbtn;
+
+	for (nbtn = 0; nbtn < joypad->bt_gpio_count; nbtn++) {
+		struct bt_gpio *gpio = &joypad->gpios[nbtn];
+
+		if (!gpio->is_adc && gpio->report_type == EV_KEY &&
+		    gpio->linux_code == code)
+			return gpio_get_value(gpio->num) == gpio->active_level;
+	}
+	return false;
+}
+
+static void joypad_dpad_report(struct joypad *joypad, struct input_dev *input)
+{
+	static const int axes[][3] = {
+		{ ABS_X, BTN_DPAD_LEFT, BTN_DPAD_RIGHT },
+		{ ABS_Y, BTN_DPAD_UP, BTN_DPAD_DOWN },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(axes); i++) {
+		bool neg = joypad_dpad_pressed(joypad, axes[i][1]);
+		bool pos = joypad_dpad_pressed(joypad, axes[i][2]);
+		int value = 0;
+
+		if (neg != pos)
+			value = neg ? input_abs_get_min(input, axes[i][0]) :
+				      input_abs_get_max(input, axes[i][0]);
+		input_report_abs(input, axes[i][0], value);
+	}
+}
