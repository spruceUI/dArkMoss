[Unit]
Description=Hand off to spruce on TF2
# The frontend starts last, after the base system is up. It does NOT depend on
# a systemd mount unit for the SD - mount-spruce.sh waits for the card itself.
After=multi-user.target
Conflicts=emulationstation.service

[Service]
Type=idle

# Kill only runtime.sh on stop, not the whole cgroup.
#
# spruce shuts the device down from save_poweroff.sh, which runs as a
# descendant of runtime.sh and, by design, kills runtime.sh on its way past.
# Under the default KillMode=control-group systemd sees the MainPID exit and
# kills every remaining process in the cgroup - including save_poweroff.sh
# itself, several steps before it reaches the poweroff. The unit deactivates
# cleanly, the device stays on, and nothing in the log says why: the script's
# last line is simply the last thing it managed to write.
#
# The frontend's children legitimately outlive it during shutdown, so process
# is the honest mode here.
KillMode=process
ExecStartPre=/usr/local/sbin/mount-spruce.sh
# Detach fbcon from the panel so the console cannot show through during the
# handoffs between PyUI and a game. Ordered here rather than at boot on purpose:
# boot messages stay visible, and only the frontend's own transitions go clean.
# Honours the /boot/darkmoss-debug flag. Non-fatal - the dash makes systemd
# ignore a failure, because a cosmetic fix must not stop the frontend starting.
ExecStartPre=-/usr/local/sbin/console-blank.sh
# runtime.sh is spruce's own entry point; it detects the platform (RGB30 here)
# and runs its main loop. Runs as root - spruce does its own mounts and touches
# hardware directly.
ExecStart=/bin/sh -lc 'exec /mnt/SDCARD/spruce/scripts/runtime.sh'
Restart=on-failure
RestartSec=3
StandardInput=tty
# NOT tty. With TTYPath=/dev/tty1 below, every echo and log_message from
# runtime.sh and everything it calls was printed straight onto the panel, so
# each game launch and exit flashed a wall of spruce narrating its own scripts.
# The journal keeps all of it and costs nothing now that dArkMoss ships a
# persistent one (64M cap, see setup_spruce_handoff-rk3566.sh) - journalctl has
# it, and darkmoss-debug.sh exports it to /boot/logs for reading off the card.
# stdin stays on the tty: the frontend still needs the VT for DRM and input.
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
