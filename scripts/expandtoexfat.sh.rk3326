#!/bin/bash
# Firstboot: grow the rootfs into the rest of the card.
#
# Upstream dArkOS did far more here - deleted the ROMS partition, capped the
# rootfs at 11GB, recreated ROMS across everything left, mkfs.exfat'd it as
# EASYROMS, mounted it, untarred an EmulationStation ROM tree and a pile of
# themes onto it, then rebooted. spruce is the frontend, it lives on TF2, and nothing on this image
# reads /roms, so all of that is gone along with the partition itself (see
# setup_partition.sh). TF1 is boot + rootfs, and the rootfs takes the whole
# card.
#
# Kept: the console font/dialog setup, so a user watching the screen still sees
# what is happening on first boot rather than a blank tty.
sudo chmod 666 /dev/tty1
export TERM=linux
sudo setfont /usr/share/consolefonts/Lat7-Terminus20x10.psf.gz
height="20"
width="60"

primary_block=mmcblk0
partition_type=$(df -T | grep mmcblk0p2 | cut -d ' ' -f 2)

exitcode=1
(
	echo 10
	# No --free-percent: the rootfs is the last partition now, so plain
	# growpart takes it to the end of the card.
	sudo growpart -v /dev/${primary_block} 2 &> /dev/null
	echo 40
	if [[ "$partition_type" == *"ext"* ]]; then
		sudo resize2fs /dev/${primary_block}p2 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"xfs"* ]]; then
		sudo xfs_growfs /dev/${primary_block}p2 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"btrfs"* ]]; then
		sudo btrfs filesystem resize max / &> /dev/null
		echo $? > /tmp/code.txt
	else
		echo "Don't know how to grow a $partition_type file system."
		echo 1 > /tmp/code.txt
	fi
	echo 80
	sync
	sudo cp -f /boot/fstab.exfat /etc/fstab &> /dev/null
	sudo rm -f /boot/doneit &> /dev/null
	sudo rm -f /boot/fstab.exfat &> /dev/null
	sync
	echo 100
) | dialog --title "Firstboot setup of dArkMoss" --gauge "Expanding the root filesystem.  Please wait..." $height $width 0 2>&1 > /dev/tty1

exitcode=$(cat /tmp/code.txt)
systemctl disable firstboot.service &> /dev/null
sudo rm -f /boot/firstboot.sh &> /dev/null
sudo rm -- "$0" &> /dev/null

if [ "$exitcode" == "0" ]; then
  dialog --infobox "Root filesystem expanded. The system will now reboot into dArkMoss." $height $width 2>&1 > /dev/tty1 | sleep 5
else
  dialog --infobox "Root filesystem expansion failed. dArkMoss will still boot - the rootfs just will not use the whole card. The system will now reboot." $height $width 2>&1 > /dev/tty1 | sleep 10
fi
reboot
