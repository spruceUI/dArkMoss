 /*----------------------------------------------------------------------------*/
+static bool joypad_dpad_pressed(struct joypad *joypad, int code)
+{
+	int nbtn;
+
+	for (nbtn = 0; nbtn < joypad->bt_gpio_count; nbtn++) {
+		struct bt_gpio *gpio = &joypad->gpios[nbtn];
+
+		if (gpio->report_type == EV_KEY && gpio->linux_code == code)
+			return gpio_get_value(gpio->num) == gpio->active_level;
+	}
+	return false;
+}
+
+static int joypad_dpad_axis(struct joypad *joypad, struct bt_adc *adc)
+{
+	bool neg = joypad_dpad_pressed(joypad,
+		adc->report_type == ABS_X ? BTN_DPAD_LEFT : BTN_DPAD_UP);
+	bool pos = joypad_dpad_pressed(joypad,
+		adc->report_type == ABS_X ? BTN_DPAD_RIGHT : BTN_DPAD_DOWN);
+
+	if (neg == pos)
+		return 0;
+	return neg ? adc->min : adc->max;
+}
