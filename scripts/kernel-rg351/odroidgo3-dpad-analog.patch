 /*----------------------------------------------------------------------------*/
+static bool joypad_is_dpad(struct bt_gpio *gpio)
+{
+	return gpio->report_type == EV_KEY &&
+		gpio->linux_code >= BTN_DPAD_UP &&
+		gpio->linux_code <= BTN_DPAD_RIGHT;
+}
+
+/*
+ * ATTRIBUTES:
+ *
+ * /sys/devices/platform/odroidgo3-joypad/dpad_analog [rw]
+ *
+ * 1: the d-pad drives ABS_X/ABS_Y at full deflection and its keys go quiet,
+ * for stickless units. 0: normal.
+ */
+static ssize_t joypad_store_dpad_analog(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf,
+				      size_t count)
+{
+	struct platform_device *pdev  = to_platform_device(dev);
+	struct joypad *joypad = platform_get_drvdata(pdev);
+	bool on = simple_strtoul(buf, NULL, 10) != 0;
+	int nbtn;
+
+	mutex_lock(&joypad->lock);
+	if (on != joypad->dpad_analog) {
+		for (nbtn = 0; nbtn < joypad->bt_gpio_count; nbtn++) {
+			struct bt_gpio *gpio = &joypad->gpios[nbtn];
+
+			if (!joypad_is_dpad(gpio))
+				continue;
+			/* release held keys; when off, held keys report again */
+			if (on && gpio->old_value == gpio->active_level)
+				input_event(joypad->input, EV_KEY,
+					gpio->linux_code, 0);
+			gpio->old_value = !gpio->active_level;
+		}
+		input_sync(joypad->input);
+		joypad->dpad_analog = on;
+	}
+	mutex_unlock(&joypad->lock);
+
+	return count;
+}
+
+static ssize_t joypad_show_dpad_analog(struct device *dev,
+				     struct device_attribute *attr,
+				     char *buf)
+{
+	struct platform_device *pdev  = to_platform_device(dev);
+	struct joypad *joypad = platform_get_drvdata(pdev);
+
+	return sprintf(buf, "%d\n", joypad->dpad_analog);
+}
+
+static DEVICE_ATTR(dpad_analog, S_IWUSR | S_IRUGO,
+		   joypad_show_dpad_analog,
+		   joypad_store_dpad_analog);
+
