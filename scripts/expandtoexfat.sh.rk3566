#!/bin/bash
# Firstboot: cap the rootfs at 11GB and give the rest of the card to a FAT32
# SPRUCEOS partition (p5), so spruce can live on this card too. A card with no
# room past 11GB gets the rootfs alone.
#
# Upstream dArkOS also untarred an EmulationStation ROM tree and themes onto
# its EASYROMS partition; spruce is the frontend, so none of that is here.
sudo chmod 666 /dev/tty1
export TERM=linux
height="15"
width="55"
if compgen -G "/boot/rk3566*" > /dev/null; then
  if test ! -z "$(cat /home/ark/.config/.DEVICE | grep RGB20PRO | tr -d '\0')"
  then
    sudo setfont /usr/share/consolefonts/Lat7-TerminusBold32x16.psf.gz
  else
    sudo setfont /usr/share/consolefonts/Lat7-TerminusBold28x14.psf.gz
  fi
  height="20"
  width="60"
fi

primary_block_partition=$(df -T | grep mmcblk[0-1]p4 | cut -d '/' -f 3 | cut -d ' ' -f 1)
primary_block=${primary_block_partition:0:7}
partition_type=$(df -T | grep mmcblk[0-1]p4 | cut -d ' ' -f 2)

ROOTFS_SECTORS=$((11 * 1024 * 1024 * 2))
disk_sectors=$(cat /sys/block/${primary_block}/size)
rootfs_start=$(cat /sys/block/${primary_block}/${primary_block}p4/start)
data_start=$(( (rootfs_start + ROOTFS_SECTORS + 2047) / 2048 * 2048 ))
make_data=0
[ $((data_start + 2048)) -lt "$disk_sectors" ] && make_data=1

exitcode=1
(
	echo 10
	# Either path also moves the backup GPT header to the end of the card.
	if [ "$make_data" = 1 ]; then
		echo "size=$ROOTFS_SECTORS" | sudo sfdisk -N 4 --no-reread --force /dev/${primary_block} &> /dev/null
		sudo partx -u -n 4 /dev/${primary_block} &> /dev/null
	else
		sudo growpart -v /dev/${primary_block} 4 &> /dev/null
	fi
	echo 30
	if [[ "$partition_type" == *"ext"* ]]; then
		sudo resize2fs /dev/${primary_block}p4 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"xfs"* ]]; then
		sudo xfs_growfs /dev/${primary_block}p4 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"btrfs"* ]]; then
		sudo btrfs filesystem resize max / &> /dev/null
		echo $? > /tmp/code.txt
	else
		echo "Don't know how to grow a $partition_type file system."
		echo 1 > /tmp/code.txt
	fi
	echo 50
	if [ "$make_data" = 1 ]; then
		# An explicit start: --append alone takes the first gap, which is U-Boot.
		echo "start=$data_start, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=\"SPRUCEOS\"" | \
			sudo sfdisk --append --no-reread --force /dev/${primary_block} &> /dev/null
		sudo partx -a -n 5 /dev/${primary_block} &> /dev/null
		sleep 2
		sudo mkfs.vfat -F 32 -n SPRUCEOS /dev/${primary_block}p5 &> /dev/null || echo 1 > /tmp/code.txt
	fi
	echo 80
	sync
	sudo cp -f /boot/fstab.exfat /etc/fstab &> /dev/null
	sudo rm -f /boot/doneit &> /dev/null
	sudo rm -f /boot/fstab.exfat &> /dev/null
	sync
	echo 100
) | dialog --title "Firstboot setup of dArkMoss" --gauge "Setting up the card.  Please wait..." $height $width 0 2>&1 > /dev/tty1

exitcode=$(cat /tmp/code.txt)
systemctl disable firstboot.service &> /dev/null
sudo rm -f /boot/firstboot.sh &> /dev/null
sudo rm -- "$0" &> /dev/null

if [ "$exitcode" == "0" ]; then
  dialog --infobox "Card set up. The system will now reboot into dArkMoss." $height $width 2>&1 > /dev/tty1 | sleep 5
else
  dialog --infobox "Card setup failed. dArkMoss will still boot, but the card may not be fully used. The system will now reboot." $height $width 2>&1 > /dev/tty1 | sleep 10
fi
reboot
