#!/bin/bash
# Firstboot: grow the rootfs into the rest of the card.
#
# Upstream dArkOS did far more here - deleted p5, capped the rootfs at 11GB,
# recreated p5 across everything left, mkfs.exfat'd it as EASYROMS, mounted it,
# untarred an EmulationStation ROM tree and a pile of themes onto it, then
# rebooted. spruce is the frontend, it lives on TF2, and nothing on this image
# reads /roms, so all of that is gone along with the partition itself (see
# setup_partition-rk3566.sh). TF1 is boot + rootfs, and the rootfs takes the
# whole card.
#
# Kept: the console font/dialog setup, so a user watching the screen still sees
# what is happening on first boot rather than a blank tty.
sudo chmod 666 /dev/tty1
export TERM=linux
height="15"
width="55"
if compgen -G "/boot/rk3566*" > /dev/null; then
  if test ! -z "$(cat /home/ark/.config/.DEVICE | grep RGB20PRO | tr -d '\0')"
  then
    sudo setfont /usr/share/consolefonts/Lat7-TerminusBold32x16.psf.gz
  else
    sudo setfont /usr/share/consolefonts/Lat7-TerminusBold28x14.psf.gz
  fi
  height="20"
  width="60"
fi

primary_block_partition=$(df -T | grep mmcblk[0-1]p4 | cut -d '/' -f 3 | cut -d ' ' -f 1)
primary_block=${primary_block_partition:0:7}
partition_type=$(df -T | grep mmcblk[0-1]p4 | cut -d ' ' -f 2)

exitcode=1
(
	echo 10
	# No --free-percent: the rootfs is the last partition now, so plain
	# growpart takes it to the end of the card. This also relocates the
	# backup GPT header, which sits at the end of the 7.5G image rather
	# than the end of the user's card until something moves it.
	sudo growpart -v /dev/${primary_block} 4 &> /dev/null
	echo 40
	if [[ "$partition_type" == *"ext"* ]]; then
		sudo resize2fs /dev/${primary_block}p4 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"xfs"* ]]; then
		sudo xfs_growfs /dev/${primary_block}p4 &> /dev/null
		echo $? > /tmp/code.txt
	elif [[ "$partition_type" == *"btrfs"* ]]; then
		sudo btrfs filesystem resize max / &> /dev/null
		echo $? > /tmp/code.txt
	else
		echo "Don't know how to grow a $partition_type file system."
		echo 1 > /tmp/code.txt
	fi
	echo 80
	sync
	sudo cp -f /boot/fstab.exfat /etc/fstab &> /dev/null
	sudo rm -f /boot/doneit &> /dev/null
	sudo rm -f /boot/fstab.exfat &> /dev/null
	sync
	echo 100
) | dialog --title "Firstboot setup of dArkMoss" --gauge "Expanding the root filesystem.  Please wait..." $height $width 0 2>&1 > /dev/tty1

exitcode=$(cat /tmp/code.txt)
systemctl disable firstboot.service &> /dev/null
sudo rm -f /boot/firstboot.sh &> /dev/null
sudo rm -- "$0" &> /dev/null

if [ "$exitcode" == "0" ]; then
  dialog --infobox "Root filesystem expanded. The system will now reboot into dArkMoss." $height $width 2>&1 > /dev/tty1 | sleep 5
else
  dialog --infobox "Root filesystem expansion failed. dArkMoss will still boot - the rootfs just will not use the whole card. The system will now reboot." $height $width 2>&1 > /dev/tty1 | sleep 10
fi
reboot
