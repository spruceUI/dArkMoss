+
+static u32 fsp_u32(const void *blob, int node, const char *name)
+{
+	int len;
+	const fdt32_t *v = fdt_getprop(blob, node, name, &len);
+
+	return (v && len >= 4) ? fdt32_to_cpu(*v) : PARAMS_INVALID_VAL;
+}
+
+static int fsp_phandle_node(const void *blob, int node, const char *name)
+{
+	int len;
+	const fdt32_t *v = fdt_getprop(blob, node, name, &len);
+
+	return (v && len >= 4) ? fdt_node_offset_by_phandle(blob, fdt32_to_cpu(*v)) : -1;
+}
+
+static const char *fsp_params_name(u32 dram_type)
+{
+	switch (dram_type) {
+	case DDR2:	return "ddr2_params";
+	case DDR3:	return "ddr3_params";
+	case DDR4:	return "ddr4_params";
+	case LPDDR2:	return "lpddr2_params";
+	case LPDDR3:	return "lpddr3_params";
+	case LPDDR4:	return "lpddr4_params";
+	case 8:		return "lpddr4x_params";
+	case 9:		return "lpddr5_params";
+	default:	return NULL;
+	}
+}
+
+/* Rockchip's dmc_fsp_probe, on a dtb in memory rather than the live tree. */
+static int do_dmc_fsp(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	const void *blob;
+	struct arm_smccc_res res;
+	int fsp, np_params, np_tim;
+	u32 *p;
+	u32 os_reg2, os_reg3, dram_type, ddr_params_version, expanded_version, phy_de_skew_en;
+	u32 i, count, count_exp = 0, size;
+	const char *phandle_name;
+
+	if (argc < 2)
+		return CMD_RET_USAGE;
+	blob = (const void *)simple_strtoul(argv[1], NULL, 16);
+	if (fdt_check_header(blob)) {
+		printf("dmc_fsp: no dtb at %s\n", argv[1]);
+		return CMD_RET_FAILURE;
+	}
+	fsp = fdt_node_offset_by_compatible(blob, -1, "rockchip,px30s-dmc-fsp");
+	if (fsp < 0 || !fdtdec_get_is_enabled(blob, fsp)) {
+		printf("dmc_fsp: no enabled rockchip,px30s-dmc-fsp node\n");
+		return CMD_RET_FAILURE;
+	}
+
+	res = sip_smc_dram(0, 0, ROCKCHIP_SIP_CONFIG_DRAM_GET_VERSION);
+	if (res.a0 || res.a1 < FSP_ATF_VERSION_PX30S) {
+		printf("dmc_fsp: trusted firmware DRAM version 0x%lx, need 0x%x\n",
+		       res.a0 ? 0 : res.a1, FSP_ATF_VERSION_PX30S);
+		return CMD_RET_FAILURE;
+	}
+
+	os_reg2 = readl(PX30_PMUGRF_BASE + PMUGRF_OS_REG(2));
+	os_reg3 = readl(PX30_PMUGRF_BASE + PMUGRF_OS_REG(3));
+	dram_type = ((os_reg2 >> 13) & 0x7) | (((os_reg3 >> 12) & 0x3) << 3);
+	phandle_name = fsp_params_name(dram_type);
+	if (!phandle_name) {
+		printf("dmc_fsp: dram type %u unsupported\n", dram_type);
+		return CMD_RET_FAILURE;
+	}
+	np_params = fsp_phandle_node(blob, fsp, phandle_name);
+	if (np_params < 0) {
+		printf("dmc_fsp: no %s node\n", phandle_name);
+		return CMD_RET_FAILURE;
+	}
+
+	ddr_params_version = fsp_u32(blob, np_params, "version");
+	if ((ddr_params_version & 0xff00) != 0x100 || (ddr_params_version & 0xffff) > 0x101) {
+		printf("dmc_fsp: ddr_params_version=0x%x unsupported\n", ddr_params_version);
+		return CMD_RET_FAILURE;
+	}
+	count = ARRAY_SIZE(ddr_params_v1);
+	expanded_version = fsp_u32(blob, np_params, "expanded_version");
+	if (expanded_version == PARAMS_INVALID_VAL)
+		expanded_version = PARAMS_IGNORE_THIS;
+	if (expanded_version != PARAMS_IGNORE_THIS) {
+		if ((expanded_version & 0xff00) != 0x100 || (expanded_version & 0xffff) > 0x100) {
+			printf("dmc_fsp: expanded_version=0x%x unsupported\n", expanded_version);
+			return CMD_RET_FAILURE;
+		}
+		count_exp = ARRAY_SIZE(ddr_params_exp_v1);
+	} else if ((ddr_params_version & 0xffff) == 0x101) {
+		count_exp = ARRAY_SIZE(ddr_params_exp_v1);
+	}
+
+	/* page 0: the dmc_fsp parameters; DTS_PAR_OFFSET / 4 bytes on: the ddr parameters */
+	size = (count + count_exp) * 4 + 4096;
+	res = sip_smc_request_share_mem(DIV_ROUND_UP(size, 4096) + 1,
+					(share_page_type_t)FSP_SHARE_PAGE_TYPE_DDRFSP);
+	if (res.a0) {
+		printf("dmc_fsp: no share memory\n");
+		return CMD_RET_FAILURE;
+	}
+	p = (u32 *)res.a1;
+	for (i = 0; i < ARRAY_SIZE(dmc_fsp_params); i++)
+		p[i] = fsp_u32(blob, fsp, dmc_fsp_params[i]);
+	phy_de_skew_en = p[1];
+
+	p = (u32 *)(res.a1 + DTS_PAR_OFFSET / 4);
+	for (i = 0; i < count; i++)
+		p[i] = fsp_u32(blob, np_params, ddr_params_v1[i]);
+
+	if (expanded_version != PARAMS_IGNORE_THIS ||
+	    (phy_de_skew_en && phy_de_skew_en != PARAMS_INVALID_VAL)) {
+		np_tim = fsp_phandle_node(blob, fsp, "ddr_timing");
+		if (np_tim < 0) {
+			printf("dmc_fsp: no ddr_timing node\n");
+			return CMD_RET_FAILURE;
+		}
+		for (i = count; i < count + ARRAY_SIZE(ddr_params_exp_v1); i++)
+			p[i] = fsp_u32(blob, np_tim, ddr_params_exp_v1[i - count]);
+		/* expanded_version and its start point */
+		if (expanded_version != PARAMS_IGNORE_THIS)
+			p[1] = (p[1] & 0xffff) | (count << 16);
+	}
+
+	flush_cache(res.a1, (DIV_ROUND_UP(size, 4096) + 1) * 0x1000);
+	res = sip_smc_dram(FSP_SHARE_PAGE_TYPE_DDRFSP, 0, FSP_SIP_CONFIG_DRAM_FSP_INIT);
+	if (res.a0) {
+		printf("dmc_fsp: fsp init error 0x%lx\n", res.a0);
+		return CMD_RET_FAILURE;
+	}
+	printf("dmc_fsp: %s set points trained\n", phandle_name);
+
+	return CMD_RET_SUCCESS;
+}
