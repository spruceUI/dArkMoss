From 14a1043772c1aa1fa929aa40a6ed4411e498f4be Mon Sep 17 00:00:00 2001
From: SundownerSport <barrettwiggin@gmail.com>
Date: Wed, 21 Oct 2026 15:45:07 -0700
Subject: [PATCH 2/2] Input: odroidgo2-joypad: allow a buttons-only pad and set
 the vendor ID

button-adc-count = <0> registers the GPIO buttons with no axes.
joypad-vendor overrides the 0x484B vendor ID. Both are optional, so
existing boards are unchanged.
---
 drivers/input/joystick/odroidgo2-joypad.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/input/joystick/odroidgo2-joypad.c b/drivers/input/joystick/odroidgo2-joypad.c
index 730d50dd1..ee6b015d4 100644
--- a/drivers/input/joystick/odroidgo2-joypad.c
+++ b/drivers/input/joystick/odroidgo2-joypad.c
@@ -648,6 +648,7 @@ static int joypad_input_setup(struct device *dev, struct joypad *joypad)
 	int nbtn, error;
 	u32 joypad_revision = 0;
 	u32 joypad_product = 0;
+	u32 joypad_vendor = 0x484B;
 
 	poll_dev = devm_input_allocate_polled_device(dev);
 	if (!poll_dev) {
@@ -668,13 +669,15 @@ static int joypad_input_setup(struct device *dev, struct joypad *joypad)
 
 	device_property_read_u32(dev, "joypad-revision", &joypad_revision);
 	device_property_read_u32(dev, "joypad-product", &joypad_product);
+	device_property_read_u32(dev, "joypad-vendor", &joypad_vendor);
 	input->id.bustype = BUS_HOST;
-	input->id.vendor  = 0x484B;
+	input->id.vendor  = (u16)joypad_vendor;
 	input->id.product = (u16)joypad_product;
 	input->id.version = (u16)joypad_revision;
 
 	/* IIO ADC key setup (0 mv ~ 1800 mv) * adc->scale */
-	__set_bit(EV_ABS, input->evbit);
+	if (joypad->bt_adc_count)
+		__set_bit(EV_ABS, input->evbit);
 	for(nbtn = 0; nbtn < joypad->bt_adc_count; nbtn++) {
 		struct bt_adc *adc = &joypad->adcs[nbtn];
 		input_set_abs_params(input, adc->report_type,
@@ -783,7 +786,7 @@ static int joypad_dt_parse(struct device *dev, struct joypad *joypad)
 
 	joypad->bt_gpio_count = device_get_child_node_count(dev);
 
-	if ((joypad->bt_adc_count == 0) || (joypad->bt_gpio_count == 0)) {
+	if (joypad->bt_gpio_count == 0) {
 		dev_err(dev, "adc key = %d, gpio key = %d error!",
 			joypad->bt_adc_count, joypad->bt_gpio_count);
 		return -EINVAL;
-- 
