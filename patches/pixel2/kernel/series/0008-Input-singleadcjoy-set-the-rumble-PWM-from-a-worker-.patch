From 130728d5814f080c6bdb07ac2b9e187529cc267a Mon Sep 17 00:00:00 2001
From: arkun <56165886+CatalyticArkun@users.noreply.github.com>
Date: Mon, 26 Oct 2026 20:50:17 -0500
Subject: [PATCH] Input: singleadcjoy: set the rumble PWM from a worker, not
 ff-memless

ff-memless plays effects under dev->event_lock with IRQs off and from a
timer, where the PWM calls may sleep: the callback now only stores the
request. rumble-boost-strong/weak lift an active-high motor's non-zero
levels. Ported from Wild Emu's TwigUI-Next fix 02e24e0be3.
---
 drivers/input/joystick/singleadcjoy.c | 88 ++++++++++++++++++++++-----
 1 file changed, 74 insertions(+), 14 deletions(-)

diff --git a/drivers/input/joystick/singleadcjoy.c b/drivers/input/joystick/singleadcjoy.c
index 37df111e4..1c2801e75 100644
--- a/drivers/input/joystick/singleadcjoy.c
+++ b/drivers/input/joystick/singleadcjoy.c
@@ -24,6 +24,7 @@
 #include <linux/property.h>
 #include <linux/of_gpio.h>
 #include <linux/delay.h>
+#include <linux/workqueue.h>
 
 #include <linux/pwm.h> // add by trngaje
 /*----------------------------------------------------------------------------*/
@@ -87,7 +88,13 @@ struct joypad {
 	struct input_dev	*input;	/* input device interface */ 
 	struct pwm_device	*pwm;	/* pwm device interface */
 	bool rumble_active_high;	/* the motor runs on a high output */
-	
+	/* ff-memless plays effects with IRQs off; rumble_work drives the PWM. */
+	struct work_struct rumble_work;
+	spinlock_t rumble_lock;
+	u32 rumble_req;			/* strong << 16 | weak */
+	bool rumble_stopped;		/* unbinding: queue no more work */
+	u32 rumble_boost_strong, rumble_boost_weak;
+
 	struct device *dev;
 	int poll_interval;
 
@@ -1049,9 +1056,9 @@ void rk_send_key_f_key_down(void)
 EXPORT_SYMBOL(rk_send_key_f_key_down);
 
 // add for rumble by trnngaje
-static int joypad_play_effect(struct input_dev *dev, void *data, struct ff_effect *effect)
+static void joypad_rumble_work(struct work_struct *work)
 {
-	struct joypad *joypad = (struct joypad *)data;
+	struct joypad *joypad = container_of(work, struct joypad, rumble_work);
 	
 	__u16 strong;
 	__u16 weak;
@@ -1059,24 +1066,32 @@ static int joypad_play_effect(struct input_dev *dev, void *data, struct ff_effec
 	int period;
 	struct pwm_state state;
 	struct pwm_args pargs;
-	
-	if (effect->type != FF_RUMBLE)
-		return 0;
+	u32 req;
 
-	if (!joypad->pwm || IS_ERR(joypad->pwm))
-		return 0;
+	spin_lock_irq(&joypad->rumble_lock);
+	req = joypad->rumble_req;
+	spin_unlock_irq(&joypad->rumble_lock);
 
-	strong = effect->u.rumble.strong_magnitude;
-	weak = effect->u.rumble.weak_magnitude;
+	strong = req >> 16;
+	weak = req & 0xffff;
 
-	/* Duty in proportion to the level at the dts's polarity; off is a low output. */
+	/*
+	 * Duty in proportion to the level at the dts's polarity; off is a low output.
+	 * A boost lifts a weak request past the motor's stall point; a stop stays 0.
+	 */
 	if (joypad->rumble_active_high) {
-		u16 level = strong ? strong : weak;
+		u32 level = 0;
+
+		if (strong)
+			level = min_t(u32, strong + joypad->rumble_boost_strong, 0xffff);
+		else if (weak)
+			level = min_t(u32, weak + joypad->rumble_boost_weak, 0xffff);
 
 		pwm_get_state(joypad->pwm, &state);
 		state.duty_cycle = div_u64((u64)level * state.period, 0xffff);
 		state.enabled = level != 0;
-		return pwm_apply_state(joypad->pwm, &state);
+		pwm_apply_state(joypad->pwm, &state);
+		return;
 	}
 
 	pwm_get_state(joypad->pwm, &state);
@@ -1085,8 +1100,43 @@ static int joypad_play_effect(struct input_dev *dev, void *data, struct ff_effec
 	period = pargs.period;
 	pwm_config(joypad->pwm,  period - (__u16)(strong * period / 0xffff), period);
 	pwm_enable(joypad->pwm);
+}
 
-	return 1;
+/*
+ * ff-memless calls this under dev->event_lock with IRQs off, and from its
+ * timer: it must not sleep, so it only records the request for rumble_work.
+ */
+static int joypad_play_effect(struct input_dev *dev, void *data, struct ff_effect *effect)
+{
+	struct joypad *joypad = (struct joypad *)data;
+	unsigned long flags;
+
+	if (effect->type != FF_RUMBLE)
+		return 0;
+
+	if (!joypad->pwm || IS_ERR(joypad->pwm))
+		return 0;
+
+	spin_lock_irqsave(&joypad->rumble_lock, flags);
+	if (!joypad->rumble_stopped) {
+		joypad->rumble_req = (u32)effect->u.rumble.strong_magnitude << 16 |
+				     effect->u.rumble.weak_magnitude;
+		schedule_work(&joypad->rumble_work);
+	}
+	spin_unlock_irqrestore(&joypad->rumble_lock, flags);
+
+	return 0;
+}
+
+/* Added after devm_pwm_get, so devm runs it before the PWM is put. */
+static void joypad_rumble_release(void *data)
+{
+	struct joypad *joypad = data;
+
+	spin_lock_irq(&joypad->rumble_lock);
+	joypad->rumble_stopped = true;
+	spin_unlock_irq(&joypad->rumble_lock);
+	cancel_work_sync(&joypad->rumble_work);
 }
 
 static int joypad_init_ff(struct joypad *joypad)
@@ -1164,10 +1214,17 @@ static int joypad_input_setup(struct device *dev, struct joypad *joypad)
 	}
 	
 	// add for rumble by trngaje
+	INIT_WORK(&joypad->rumble_work, joypad_rumble_work);
+	spin_lock_init(&joypad->rumble_lock);
 	joypad->pwm = devm_pwm_get(dev, NULL);
 	if (IS_ERR(joypad->pwm) && PTR_ERR(joypad->pwm) != -EPROBE_DEFER) {
 		dev_err(dev, "unable to request PWM for rumble\n");
 	}
+	if (!IS_ERR(joypad->pwm)) {
+		error = devm_add_action_or_reset(dev, joypad_rumble_release, joypad);
+		if (error)
+			return error;
+	}
 	/* Start an active-high motor off, at the dts's period and polarity. */
 	if (!IS_ERR(joypad->pwm) && joypad->rumble_active_high) {
 		struct pwm_state state;
@@ -1285,6 +1342,9 @@ static int joypad_dt_parse(struct device *dev, struct joypad *joypad)
 
 	joypad->auto_repeat = device_property_present(dev, "autorepeat");
 	joypad->rumble_active_high = device_property_present(dev, "rumble-active-high");
+	/* Added to every non-zero level of a rumble-active-high motor (rocknix-joypad's names). */
+	device_property_read_u32(dev, "rumble-boost-strong", &joypad->rumble_boost_strong);
+	device_property_read_u32(dev, "rumble-boost-weak", &joypad->rumble_boost_weak);
 
 	joypad->bt_gpio_count = device_get_child_node_count(dev);
 
-- 
