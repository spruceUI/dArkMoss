+
+/* V4: speaker is on an external amplifier, as the vendor dtb sets */
+&rk817_codec {
+	spk-mute-delay-ms = <50>;
+	use-ext-amplifier;
+};
+
+/* V4: PVTM sits on the bin-0/1 edge; bin 1 undervolts and oopses. Pin bin 0. */
+&cpu0_opp_table {
+	/delete-property/ rockchip,pvtm-voltage-sel;
+};
+
+&gpu_opp_table {
+	/delete-property/ rockchip,pvtm-voltage-sel;
+};
+
+&dmc_opp_table {
+	/delete-property/ rockchip,pvtm-voltage-sel;
+};
