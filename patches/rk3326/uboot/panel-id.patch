+ofnode rockchip_panel_node(struct rockchip_panel *panel)
+{
+	struct rockchip_panel_plat *plat;
+
+	if (panel->funcs != &rockchip_panel_funcs)
+		return dev_ofnode(panel->dev);
+
+	plat = dev_get_platdata(panel->dev);
+	return plat->node;
+}
+
+bool rockchip_panel_retarget_pending(struct rockchip_panel *panel)
+{
+	struct rockchip_panel_plat *plat;
+
+	if (!panel || panel->funcs != &rockchip_panel_funcs)
+		return false;
+
+	plat = dev_get_platdata(panel->dev);
+	return ofnode_valid(plat->retarget);
+}
+
+/*
+ * Take the commands, delays and ID of the sibling node the panel's ID named; the
+ * caller rebuilds the display so the timings come from it too. Once per boot.
+ */
+bool rockchip_panel_retarget(struct rockchip_panel *panel)
+{
+	struct rockchip_panel_plat *plat;
+	struct rockchip_panel_priv *priv;
+	ofnode node;
+
+	if (!rockchip_panel_retarget_pending(panel))
+		return false;
+
+	plat = dev_get_platdata(panel->dev);
+	priv = dev_get_priv(panel->dev);
+	node = plat->retarget;
+	priv->retargeted = true;
+
+	rockchip_panel_free_cmds(plat->on_cmds);
+	rockchip_panel_free_cmds(plat->off_cmds);
+	plat->on_cmds = NULL;
+	plat->off_cmds = NULL;
+	if (rockchip_panel_parse_node(plat, node))
+		return false;
+
+	panel->bus_format = plat->bus_format;
+	panel->bpc = plat->bpc;
+	return true;
 }
 
