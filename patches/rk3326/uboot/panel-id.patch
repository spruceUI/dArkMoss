+/*
+ * Read the panel's ID over DSI. When it answers with a sibling panel node's "id",
+ * queue a switch to that node and return true; any failure keeps the current node.
+ */
+static bool rockchip_panel_identify(struct rockchip_panel *panel,
+				    struct mipi_dsi_device *dsi)
+{
+	struct rockchip_panel_plat *plat = dev_get_platdata(panel->dev);
+	struct rockchip_panel_priv *priv = dev_get_priv(panel->dev);
+	const char *name = ofnode_get_name(plat->node);
+	ofnode sib;
+	ssize_t ret;
+	char hex[sizeof(plat->id) * 2 + 1];
+	u8 id[sizeof(plat->id)];
+	int i, len;
+
+	for (i = 0; i < 5; i++) {
+		mipi_dsi_set_maximum_return_packet_size(dsi, plat->id_len);
+		ret = mipi_dsi_dcs_read(dsi, plat->id_reg, id, plat->id_len);
+		if (ret == plat->id_len)
+			break;
+		printf("panel: ID read %d failed (%d)\n", i + 1, (int)ret);
+		mdelay(20);
+	}
+	if (ret != plat->id_len) {
+		printf("panel: ID read failed, keeping %s\n", name);
+		return false;
+	}
+
+	for (i = 0; i < plat->id_len; i++)
+		sprintf(&hex[i * 2], "%02x", id[i]);
+	env_set("panel_id", hex);
+
+	if (!memcmp(id, plat->id, plat->id_len) || priv->retargeted)
+		return false;
+
+	ofnode_for_each_subnode(sib, ofnode_get_parent(plat->node)) {
+		const u8 *sid = ofnode_get_property(sib, "id", &len);
+
+		if (ofnode_equal(sib, plat->node) ||
+		    strncmp(ofnode_get_name(sib), "panel", 5))
+			continue;
+		if (sid && len == plat->id_len && !memcmp(sid, id, len)) {
+			printf("panel: ID %s is %s, switching from %s\n", hex,
+			       ofnode_get_name(sib), name);
+			plat->retarget = sib;
+			return true;
+		}
+	}
+
+	printf("panel: ID %s matches no panel node, keeping %s\n", hex, name);
+	return false;
+}
